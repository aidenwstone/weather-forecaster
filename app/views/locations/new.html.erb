<h1>Add a new Location</h1>

<% flash.each do |type, msg| %>
  <div>
    <p><strong><%= msg %></strong></p>
  </div>
<% end %>

<%= button_to "Cancel", locations_path, method: :get %>

<p>Enter an address or an IP address, along with an optional nickname, and then watch the magic happen!</p>

<% if @location.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@location.errors.count, "error") %> prohibited this location from being saved:</h2>

    <ul>
    <% @location.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @location do |form| %>
  <div>
    <p><%= form.label :address %></p>
    <p><%= form.text_field :address %></p>
  </div>

  <div>
    <p><%= form.label :ip_address %></p>
    <p><%= form.text_field :ip_address %></p>
  </div>

  <div>
    <p><%= form.label :nickname %></p>
    <p><%= form.text_field :nickname %></p>
  </div>

  <%= form.submit "Add Location" %>
<% end %>
