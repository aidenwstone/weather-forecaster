<%= link_to "Back", locations_path %>

<h1>
  <%= @location.nickname.strip.empty? ? @location.name : @location.nickname %> | 
  <%= @location.address.strip.empty? ? @location.ip_address : @location.address %>
</h1>

<%= button_to "Remove location", @location, method: :delete, data: { turbo_confirm: "Are you sure?" } %>

<% if @weather == :unreachable %>
  <p>Hmmm... We couldn't get the weather data right now. Maybe try again later.</p>
<% else %>
  <% @weather.each do |day| %>
      <div>
        <h3><strong><%= day[:weekday] %></strong></h3>
        <p>High: <strong><%= day[:high_temp] %>&#8457;</strong> | Low: <strong><%= day[:low_temp] %>&#8457;</strong></p>
      </div>
  <% end %>

  <% chart_json = {
    type: "line",
    data: {
      labels: @weather.collect{ |day| day[:weekday] },
      datasets: [
        {
          backgroundColor: "rgba(204, 0, 0, 0.5)",
          borderColor: "rgb(255, 128, 128)",
          data: @weather.collect{ |day| day[:high_temp] },
          label: "High Temps",
          fill: "none"
        },
        {
          backgroundColor: "rgba(0, 136, 204, 0.5)",
          borderColor: "rgb(128, 212, 255)",
          data: @weather.collect{ |day| day[:low_temp] },
          label: "Low Temps",
          fill: "none"
        }
      ]
    }
  } %>

  <%= image_tag("https://image-charts.com/chart.js/2.8.0?bkg=white&c=#{chart_json}") %>
<% end %>
